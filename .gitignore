# Local Pi runtime state
.atl/
.pi/

# Node / build
node_modules/
dist/

# Raw catalog extraction (never commit; keep local only)
raw-catalog.json

# Windows/WSL NTFS metadata artifacts (e.g. raw-catalog.json:Zone.Identifier)
*:Zone.Identifier

# Logs / editor noise
*.log
.DS_Store

# Local environment (Firebase config). `.env.example` is committed; the real file is not.
# The Firebase web config is not a secret in itself, but this file is where a secret would
# end up next, so the rule lands before the first variable does.
.env
.env.local
.env.*.local
