# Local Pi runtime state
.atl/
.pi/
.codegraph/
# Impeccable working artifacts: PRODUCT.md/DESIGN.md are the tracked truth, this is generated
.impeccable/

# Node / build
node_modules/
dist/

# Raw catalog extraction (never commit; keep local only)
raw-catalog.json

# Generated catalog data (never commit; it lives on the `datos` branch and reaches the
# build through `npm run fetch-data`). See odd/tasks/catalog-refresh.md (D7). The entries are
# still tracked on main until the untracking commit; this rule stops new ones appearing.
public/data/

# Windows/WSL NTFS metadata artifacts (e.g. raw-catalog.json:Zone.Identifier)
*:Zone.Identifier

# Logs / editor noise
*.log
.DS_Store

# Local environment (Firebase config). `.env.example` is committed; the real file is not.
# The Firebase web config is not a secret in itself, but this file is where a secret would
# end up next, so the rule lands before the first variable does.
.env
.env.local
.env.*.local
